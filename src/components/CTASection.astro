---
import { getLocaleFromPath, getTranslations } from '../i18n/translations';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const defaultTitle = t.cta.title;
const defaultSubtitle = t.cta.subtitle;
---

<section class="cta">
  <div class="container">
    <div class="cta-content">
      <h2>{title ?? defaultTitle}</h2>
      <p>{subtitle ?? defaultSubtitle}</p>
      <a href="https://dash.nabdaotp.com/" target="_blank" rel="noopener noreferrer" class="btn btn-white btn-lg">
        {t.cta.action}
      </a>
    </div>
  </div>
</section>
