---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { blogPosts, type BlogPost } from '../../data/blog';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.title,
  description: post.metaDescription,
  author: { '@type': 'Organization', name: 'Nabda OTP', url: 'https://nabdaotp.com' },
  publisher: { '@type': 'Organization', name: 'Nabda OTP', logo: { '@type': 'ImageObject', url: 'https://nabdaotp.com/assets/android-chrome-192x192.png' } },
  datePublished: post.publishDate,
  dateModified: post.publishDate,
  url: `https://nabdaotp.com/blog/${post.slug}`,
  keywords: post.keywords.join(', '),
};

function renderMarkdown(content: string): string {
  return content
    .replace(/```(\w+)?\n([\s\S]*?)```/g, (_: string, lang: string, code: string) => {
      const escaped = code.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `<div style="margin:1.5rem 0;"><div style="background:var(--gray-800);padding:.5rem 1rem;border-radius:var(--radius-md) var(--radius-md) 0 0;display:flex;justify-content:space-between;"><span style="color:#fff;font-size:.75rem;font-weight:500;">${lang || 'code'}</span></div><pre style="background:var(--deep-navy);border-radius:0 0 var(--radius-md) var(--radius-md);padding:1.25rem;overflow-x:auto;margin:0;"><code style="font-family:var(--font-mono);font-size:.8125rem;color:var(--gray-300);line-height:1.7;">${escaped}</code></pre></div>`;
    })
    .replace(/^### (.+)$/gm, '<h3 style="font-size:1.25rem;font-weight:600;color:var(--deep-navy);margin-top:1.5rem;margin-bottom:.75rem;">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 style="font-size:1.75rem;font-weight:700;color:var(--deep-navy);margin-top:2rem;margin-bottom:1rem;">$1</h2>')
    .replace(/^# (.+)$/gm, '<h1 style="font-size:2rem;font-weight:800;color:var(--deep-navy);margin-top:2.5rem;margin-bottom:1.5rem;">$1</h1>')
    .replace(/\*\*(.*?)\*\*/g, '<strong style="color:var(--deep-navy);font-weight:600;">$1</strong>')
    .replace(/`([^`]+)`/g, '<code style="background:var(--gray-100);color:var(--blurple-dark);padding:.125rem .375rem;border-radius:4px;font-family:var(--font-mono);font-size:.875em;">$1</code>')
    .replace(/^\|(.+)\|$/gm, (match: string) => {
      if (match.includes('---')) return '';
      const cells = match.split('|').filter((c: string) => c.trim());
      return '<tr>' + cells.map((c: string) => `<td style="border:1px solid var(--gray-200);padding:.75rem;font-size:.9375rem;color:var(--navy-lighter);">${c.trim()}</td>`).join('') + '</tr>';
    })
    .replace(/^---$/gm, '<hr style="border:none;border-top:1px solid var(--gray-200);margin:2rem 0;" />')
    .replace(/^- (.+)$/gm, '<li style="display:flex;align-items:flex-start;gap:.5rem;color:var(--navy-lighter);font-size:.9375rem;margin-bottom:.25rem;"><span style="color:var(--blurple);flex-shrink:0;margin-top:2px;">•</span><span>$1</span></li>')
    .replace(/(<li[^>]*>.*<\/li>\n?)+/g, (match: string) => `<ul style="margin:1rem 0;">${match}</ul>`)
    .replace(/\n\n([^<\n])/g, '\n\n<p style="color:var(--navy-lighter);line-height:1.8;margin-bottom:1rem;">$1')
    .replace(/([^>])\n\n/g, '$1</p>\n\n');
}
---

<BaseLayout
  title={post.metaTitle}
  description={post.metaDescription}
  canonical={`https://nabdaotp.com/blog/${post.slug}`}
  schema={articleSchema}
>
  <Navbar />

  <article style="max-width:800px; margin:0 auto; padding:6rem 1.5rem 4rem;">
    <!-- Breadcrumb -->
    <nav style="display:flex; align-items:center; gap:.5rem; font-size:.875rem; color:var(--gray-500); margin-bottom:2rem;">
      <a href="/" style="color:var(--blurple);">Home</a>
      <span>/</span>
      <a href="/blog" style="color:var(--blurple);">Blog</a>
      <span>/</span>
      <span style="color:var(--deep-navy); font-weight:500;">{post.title}</span>
    </nav>

    <!-- Article header -->
    <header style="margin-bottom:2.5rem;">
      <div style="display:flex; align-items:center; gap:.75rem; margin-bottom:1rem;">
        <span class="badge">{post.category}</span>
        <span style="font-size:.875rem; color:var(--gray-500);">{post.readTime}</span>
      </div>

      <h1 style="font-size:clamp(1.75rem,4vw,2.5rem); font-weight:800; color:var(--deep-navy); line-height:1.2; margin-bottom:1rem;">
        {post.title}
      </h1>

      <p style="font-size:1.125rem; color:var(--navy-lighter); line-height:1.7; margin-bottom:1.5rem;">
        {post.excerpt}
      </p>

      <div style="display:flex; align-items:center; gap:1rem; font-size:.875rem; color:var(--gray-500); padding-bottom:1.5rem; border-bottom:1px solid var(--gray-200);">
        <span>By {post.author}</span>
        <span>•</span>
        <time datetime={post.publishDate}>{post.publishDate}</time>
        <span>•</span>
        <span>{post.readTime}</span>
      </div>
    </header>

    <!-- Article content -->
    <div>
      <div set:html={renderMarkdown(post.content)} />
    </div>

    <!-- Tags -->
    <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--gray-200);">
      <div style="display:flex; flex-wrap:wrap; gap:.5rem;">
        {post.keywords.map((kw) => (
          <span style="padding:.25rem .75rem; background:var(--gray-100); border:1px solid var(--gray-200); border-radius:100px; font-size:.75rem; color:var(--gray-500);">
            {kw}
          </span>
        ))}
      </div>
    </div>

    <!-- Related posts -->
    <div style="margin-top:3rem;">
      <h2 style="font-size:1.25rem; font-weight:700; color:var(--deep-navy); margin-bottom:1.5rem;">Related Articles</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:1rem;">
        {blogPosts
          .filter((p) => p.slug !== post.slug)
          .slice(0, 4)
          .map((p) => (
            <a href={`/blog/${p.slug}`} class="page-card">
              <div class="badge" style="font-size:.75rem; margin-bottom:.5rem;">{p.category}</div>
              <h3 style="font-size:.9375rem; font-weight:600; color:var(--deep-navy); line-height:1.4;">
                {p.title}
              </h3>
              <p style="font-size:.75rem; color:var(--gray-500); margin-top:.5rem;">{p.readTime}</p>
            </a>
          ))}
      </div>
    </div>
  </article>

  <CTASection />
  <Footer />
</BaseLayout>
