---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { countries } from '../../data/countries';
import { getTranslations } from '../../i18n/translations';
import { regionLabels } from '../../i18n/page-content';

const locale = 'en';
const t = getTranslations(locale);
const regions = ['arab', 'asia', 'latam', 'africa', 'europe'] as const;
---

<BaseLayout
  title="All Countries — WhatsApp API Coverage | Nabda OTP"
  description="Browse all supported countries for Nabda OTP. WhatsApp API and OTP verification with the same $10/month unlimited pricing."
  canonical="https://nabdaotp.com/countries/"
>
  <Navbar />
  <section class="hero" style="min-height:auto; padding:7rem 0 3rem;">
    <div class="hero-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container">
      <div class="hero-text" style="max-width:860px;">
        <div class="badge">🌍 Global Coverage</div>
        <h1 class="hero-title">All Countries</h1>
        <p class="hero-subtitle">
          Nabda OTP supports {countries.length} countries with the same flat pricing:
          <strong> $10/month unlimited messages</strong>.
        </p>
      </div>
    </div>
  </section>

  <section style="padding:3rem 0 4rem; background:var(--off-white);">
    <div class="container">
      {regions.map((region) => (
        <div style="margin-bottom:2rem;">
          <h2 style="font-size:1.125rem; font-weight:700; color:var(--deep-navy); margin-bottom:0.9rem;">
            {regionLabels[locale][region]}
          </h2>
          <div class="page-link-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
            {countries.filter((country) => country.region === region).map((country) => (
              <a href={`/countries/${country.slug}`} class="page-card" style="text-decoration:none;">
                <div style="font-weight:700; color:var(--deep-navy);">{country.name}</div>
                <div style="font-size:.8125rem; color:var(--gray-500); margin-top:.35rem;">{country.phoneCode}</div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <Footer />
</BaseLayout>
