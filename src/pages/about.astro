---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="About Nabda OTP — First Arab WhatsApp Gateway | $10/mo Unlimited"
  description="Learn about Nabda OTP — the first Arab WhatsApp gateway and the cheapest WhatsApp API at $10/month unlimited. Built for developers in Iraq, MENA, and worldwide."
  canonical="https://nabdaotp.com/about"
>
  <Navbar />

  <section class="pt-16 pb-8 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="badge mb-6">🤍 Our Story</div>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6">
      About Nabda OTP
    </h1>
    <p class="text-xl text-gray-400 leading-relaxed">
      Nabda OTP is the first Arab WhatsApp gateway — built by Arab developers,
      for developers everywhere. We offer unlimited WhatsApp messaging for a flat $10/month.
    </p>
  </section>

  <section class="py-12 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="prose-dark space-y-8">
      <div class="card">
        <h2 class="text-2xl font-bold text-white mb-4">Our Mission</h2>
        <p class="text-gray-400 leading-relaxed">
          We believe every developer — regardless of their location or budget — should have access
          to affordable, reliable WhatsApp messaging. Nabda OTP was founded to make the best
          WhatsApp API accessible to everyone, from solo developers to large enterprises.
        </p>
        <p class="text-gray-400 leading-relaxed mt-4">
          While global providers charge $0.005–$0.05 per message, we offer a simple flat fee:
          $10/month for unlimited messages. No surprises. No scaling bills. Just reliable
          WhatsApp OTP delivery at a price everyone can afford.
        </p>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-white mb-4">The First Arab WhatsApp Gateway</h2>
        <p class="text-gray-400 leading-relaxed">
          Nabda OTP was founded with a focus on the Arab world — Iraq, Syria, Saudi Arabia,
          UAE, and the broader MENA region. We are the first WhatsApp API provider to offer:
        </p>
        <ul class="space-y-2 mt-4">
          {[
            'Full Arabic Unicode support for messages and documentation',
            'RTL (right-to-left) text handling for Arabic content',
            'Arabic language customer support',
            'Deep understanding of MENA telecom infrastructure',
            'Local market expertise in Iraq, Syria, and the Gulf states',
          ].map((item) => (
            <li class="flex items-start gap-3 text-gray-300 text-sm">
              <svg class="w-4 h-4 text-accent-green flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-white mb-4">Why We Built Nabda OTP</h2>
        <p class="text-gray-400 leading-relaxed">
          As Arab developers, we experienced firsthand how expensive and complex WhatsApp API
          integration was. Twilio charged per message, making it impractical for startups.
          The setup processes were complex and designed for enterprise, not for developers
          who need a simple, affordable solution.
        </p>
        <p class="text-gray-400 leading-relaxed mt-4">
          Nabda OTP was born from this frustration. We wanted a simple API, transparent pricing,
          and a product that understood the Arab market. Today, thousands of developers use
          Nabda OTP to power their applications' verification and messaging needs.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          { value: '1,000+', label: 'Businesses Trust Us', icon: '🏢' },
          { value: '10M+', label: 'Messages Delivered', icon: '📨' },
          { value: '50+', label: 'Countries Served', icon: '🌍' },
        ].map(({ value, label, icon }) => (
          <div class="card text-center">
            <div class="text-3xl mb-2">{icon}</div>
            <div class="text-3xl font-bold text-white mb-1">{value}</div>
            <div class="text-gray-400 text-sm">{label}</div>
          </div>
        ))}
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-white mb-4">Contact</h2>
        <p class="text-gray-400 text-sm mb-4">
          Have questions? We're here to help. Our support team speaks English and Arabic.
        </p>
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2 text-gray-400">
            <span>📧</span>
            <a href="mailto:support@nabdaotp.com" class="text-brand hover:underline">support@nabdaotp.com</a>
          </div>
          <div class="flex items-center gap-2 text-gray-400">
            <span>💬</span>
            <a href="https://wa.me/905346639145" target="_blank" rel="noopener" class="text-brand hover:underline">WhatsApp Support</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
  <Footer />
</BaseLayout>
