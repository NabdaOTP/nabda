---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQSection from '../../../components/FAQSection.astro';
import { competitors, type Competitor } from '../../../data/competitors';
import {
  ALL_LOCALES,
  getTranslations,
  isLocaleCode,
  isRtlLocale,
  withLocalePath,
  type LocaleCode,
} from '../../../i18n/translations';

export function getStaticPaths() {
  return ALL_LOCALES.flatMap((lang) =>
    competitors.map((competitor) => ({
      params: { lang, slug: competitor.slug },
      props: { competitor },
    })),
  );
}

const langParam = Astro.params.lang ?? 'en';
const locale: LocaleCode = isLocaleCode(langParam) ? langParam : 'en';
const dir = isRtlLocale(locale) ? 'rtl' : 'ltr';
const t = getTranslations(locale);
const { competitor } = Astro.props as { competitor: Competitor };

const faqs = [
  { q: `Nabda OTP vs ${competitor.name}?`, a: `Nabda OTP offers $10/month unlimited messaging while ${competitor.name} typically uses higher or variable pricing.` },
  { q: 'WhatsApp support?', a: 'Nabda OTP provides WhatsApp API support with simple REST integration.' },
  { q: 'Best for OTP?', a: 'Nabda OTP is built for OTP and notifications with predictable flat pricing.' },
];
---

<BaseLayout
  title={`Nabda OTP vs ${competitor.name} | Comparison`}
  description={`Compare Nabda OTP and ${competitor.name} pricing, setup time, and WhatsApp API support.`}
  lang={locale}
  dir={dir}
  canonical={`https://nabdaotp.com${withLocalePath(locale, `/compare/${competitor.slug}`)}`}
>
  <Navbar />
  <section class="hero" style="min-height:auto; padding:7rem 0 3rem;">
    <div class="hero-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container">
      <h1 class="hero-title">Nabda OTP vs {competitor.name}</h1>
      <p class="hero-subtitle">{competitor.tagline}</p>
    </div>
  </section>

  <section style="padding:3rem 0; background:var(--off-white);">
    <div class="container" style="max-width:860px;">
      <div style="overflow-x:auto; border:1px solid var(--gray-200); border-radius:var(--radius-lg);">
        <table class="comparison-table" style="min-width:680px;">
          <thead>
            <tr>
              <th>Feature</th>
              <th>✅ Nabda OTP</th>
              <th>{competitor.name}</th>
            </tr>
          </thead>
          <tbody>
            {competitor.features.map((feature) => (
              <tr>
                <td>{feature.name}</td>
                <td>{feature.nabda}</td>
                <td>{feature.competitor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section style="padding:3rem 0; background:var(--white);">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{t.common.faqTitle}</h2>
      </div>
      <FAQSection faqs={faqs} />
    </div>
  </section>

  <CTASection />
  <Footer />
</BaseLayout>
