    <div class="container">
      <div class="section-header">
        <h2 class="section-title">WhatsApp API Solutions</h2>
        <p class="section-subtitle">Everything you need to send OTPs, verify users, and build secure authentication — all for $10/month.</p>
      </div>
      <div class="features-grid">
        {solutions.map((sol, i) => (
          <a href={`/solutions/${sol.slug}`} class="feature-card" style="text-decoration:none; display:flex; flex-direction:column;">
            <div class="feature-icon">
              {['🔐','💬','📧','📡','🏢','🛡️','📱','✅'][i] ?? '⚡'}
            </div>
            <h3>{sol.title}</h3>
            <p style="flex:1;">{sol.heroSubtitle.slice(0, 100)}...</p>
            <div style="margin-top:1rem; font-size:.875rem; font-weight:600; color:var(--blurple);">
              Learn more →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== COUNTRIES SECTION ===== -->
  <section style="padding: 4rem 0; background: var(--off-white);" id="countries">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">WhatsApp API by Country</h2>
        <p class="section-subtitle">Nabda OTP works in 50+ countries. Same $10/month unlimited price everywhere.</p>
      </div>

      <!-- Arab Countries -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size:1rem; font-weight:700; color:var(--navy-lighter); text-transform:uppercase; letter-spacing:.05em; margin-bottom:1rem;">🌍 Arab Countries & MENA</h3>
        <div class="page-link-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
          {arabCountries.map((c) => (
            <a href={`/countries/${c.slug}`} class="page-card" style="text-decoration:none;">
              <div style="font-weight:600; color:var(--deep-navy); font-size:.9375rem;">{c.name}</div>
              <div style="font-size:.75rem; color:var(--gray-500); margin-top:.25rem;">{c.phoneCode} · WhatsApp API</div>
            </a>
          ))}
        </div>
      </div>

      <!-- Asia + Others -->
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size:1rem; font-weight:700; color:var(--navy-lighter); text-transform:uppercase; letter-spacing:.05em; margin-bottom:1rem;">🌐 Asia, LATAM & More</h3>
        <div class="page-link-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
          {[...asiaCountries, ...otherCountries].map((c) => (
            <a href={`/countries/${c.slug}`} class="page-card" style="text-decoration:none;">
              <div style="font-weight:600; color:var(--deep-navy); font-size:.9375rem;">{c.name}</div>
              <div style="font-size:.75rem; color:var(--gray-500); margin-top:.25rem;">{c.phoneCode} · WhatsApp API</div>
            </a>
          ))}
        </div>
      </div>

      <div style="text-align:center;">
        <a href="/countries/" class="btn btn-ghost" style="border:1px solid var(--gray-200);">
          View All 50 Countries →
        </a>
      </div>
    </div>
  </section>

  <!-- ===== COMPARISONS SECTION ===== -->
  <section style="padding: 4rem 0; background: var(--white);" id="compare">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Nabda OTP vs Competitors</h2>
        <p class="section-subtitle">See how Nabda OTP compares to Twilio, UltraMsg, SendGrid, and 13 other services. Spoiler: we're 90% cheaper.</p>
      </div>

      <div class="page-link-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin-bottom:2rem;">
        {competitors.map((c) => (
          <a href={`/compare/${c.slug}`} class="page-card" style="text-decoration:none;">
            <div style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--gray-500); margin-bottom:.5rem;">vs</div>
            <div style="font-weight:700; color:var(--deep-navy); font-size:1rem; margin-bottom:.25rem;">{c.name}</div>
            <div style="font-size:.8125rem; color:var(--gray-500);">{c.tagline.slice(0, 50)}</div>
            <div style="margin-top:.75rem; font-size:.8125rem; font-weight:600; color:var(--success);">Nabda wins →</div>
          </a>
        ))}
      </div>

      <!-- Quick comparison table -->
      <div style="overflow-x:auto; border-radius:var(--radius-lg); border:1px solid var(--gray-200); max-width:700px; margin:0 auto;">
        <table style="width:100%; min-width:640px; border-collapse:collapse; font-size:.9375rem;">
          <thead>
            <tr style="background:var(--deep-navy); color:#fff;">
              <th style="text-align:left; padding:.875rem 1rem;">Service</th>
              <th style="padding:.875rem 1rem; text-align:center;">Price</th>
              <th style="padding:.875rem 1rem; text-align:center;">Model</th>
              <th style="padding:.875rem 1rem; text-align:center;">MENA</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background:rgba(99,91,255,.04);">
              <td style="padding:.875rem 1rem; font-weight:700; color:var(--blurple);">✅ Nabda OTP</td>
              <td style="padding:.875rem 1rem; text-align:center; font-weight:700; color:var(--success);">$10/mo</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--success); font-weight:600;">Unlimited</td>
              <td style="padding:.875rem 1rem; text-align:center;">✅ Full</td>
            </tr>
            <tr style="border-top:1px solid var(--gray-100);">
              <td style="padding:.875rem 1rem; color:var(--deep-navy);">Twilio</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--error);">$75–$750/mo</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Per message</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Partial</td>
            </tr>
            <tr style="border-top:1px solid var(--gray-100); background:var(--gray-50);">
              <td style="padding:.875rem 1rem; color:var(--deep-navy);">UltraMsg</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--error);">$29–$99/mo</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Per message</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Partial</td>
            </tr>
            <tr style="border-top:1px solid var(--gray-100);">
              <td style="padding:.875rem 1rem; color:var(--deep-navy);">Vonage</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--error);">$95+/mo</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Per message</td>
              <td style="padding:.875rem 1rem; text-align:center; color:var(--gray-500);">Limited</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== BLOG SECTION ===== -->
  <section style="padding: 4rem 0; background: var(--off-white);" id="blog">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Developer Blog</h2>
        <p class="section-subtitle">Tutorials, code examples, and guides for WhatsApp API integration.</p>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:1.5rem; margin-bottom:2rem;">
        {blogPosts.slice(0, 3).map((post) => (
          <a href={`/blog/${post.slug}`} class="feature-card" style="text-decoration:none; display:flex; flex-direction:column;">
            <div class="badge" style="width:fit-content; margin-bottom:1rem; font-size:.75rem;">{post.category}</div>
            <h3 style="font-size:1.0625rem; flex:1;">{post.title}</h3>
            <p style="font-size:.875rem; color:var(--navy-lighter); margin-top:.75rem; line-height:1.6;">
              {post.excerpt.slice(0, 110)}...
            </p>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--gray-100);">
              <span style="font-size:.75rem; color:var(--gray-500);">{post.readTime}</span>
              <span style="font-size:.875rem; font-weight:600; color:var(--blurple);">Read →</span>
            </div>
          </a>
        ))}
      </div>

      <div style="text-align:center;">
        <a href="/blog" class="btn btn-ghost" style="border:1px solid var(--gray-200);">
          View All Articles →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
