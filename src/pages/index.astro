---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import { countries } from '../data/countries';
import { competitors } from '../data/competitors';
import { solutions } from '../data/solutions';
import { blogPosts } from '../data/blog';

// Featured countries by region for homepage display
const arabCountries = countries.filter(c => c.region === 'arab').slice(0, 8);
const asiaCountries = countries.filter(c => c.region === 'asia').slice(0, 5);
const otherCountries = countries.filter(c => !['arab','asia'].includes(c.region)).slice(0, 5);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Nabda OTP - WhatsApp API",
  "alternateName": ["Nabda OTP", "نبضة OTP", "Nabda WhatsApp Gateway", "Nabda API"],
  "applicationCategory": "BusinessApplication",
  "applicationSubCategory": "Messaging API",
  "operatingSystem": "Web, iOS, Android",
  "description": "The CHEAPEST WhatsApp OTP API service - Just $10/month for UNLIMITED messages. Best alternative to Twilio, SendGrid, and UltraMsg. First Arab WhatsApp Gateway for Iraq, Syria, and MENA region. RESTful API with 99.99% uptime. No per-message fees.",
  "url": "https://nabdaotp.com",
  "downloadUrl": "https://api.nabdaotp.com/docs",
  "screenshot": "https://nabdaotp.com/assets/android-chrome-192x192.png",
  "softwareVersion": "2.0",
  "offers": {
    "@type": "Offer",
    "name": "Unlimited WhatsApp Messages",
    "price": "10.00",
    "priceCurrency": "USD",
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://nabdaotp.com/#pricing",
    "description": "Unlimited WhatsApp OTP and notification messages for $10/month. No per-message fees. 5-day free trial included.",
    "eligibleRegion": ["IQ","SY","SA","AE","KW","QA","BH","OM","JO","LB","EG"]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "150",
    "bestRating": "5",
    "worstRating": "1"
  },
  "featureList": [
    "Unlimited WhatsApp Messages - No caps or limits",
    "No Per-Message Fee - Flat $10/month",
    "RESTful API - Easy integration",
    "5-Day Free Trial - No credit card required",
    "99.99% Uptime Guarantee",
    "Arabic Language Support",
    "Iraq and Syria Phone Number Support",
    "MENA Region Optimized",
    "Twilio Alternative",
    "UltraMsg Alternative"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the cheapest WhatsApp API service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nabda OTP is the cheapest WhatsApp API service, offering unlimited messages for just $10/month. Unlike Twilio, SendGrid, or UltraMsg which charge per message, Nabda OTP offers a flat monthly fee with no per-message charges."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best Twilio alternative for WhatsApp API?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nabda OTP is the best Twilio alternative for WhatsApp API. While Twilio charges per message, Nabda OTP offers unlimited messages for $10/month with better support for Arabic language and Middle Eastern phone numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a WhatsApp API with unlimited messages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Nabda OTP offers unlimited WhatsApp messages for a flat fee of $10/month. No message limits, no per-message fees."
      }
    },
    {
      "@type": "Question",
      "name": "Does Nabda OTP offer a free trial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Nabda OTP offers a 5-day free trial with no credit card required. Test the full WhatsApp API functionality before committing."
      }
    },
    {
      "@type": "Question",
      "name": "What is the most reliable WhatsApp API for MENA region?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nabda OTP is the most reliable WhatsApp API for the MENA region with 99.99% uptime guarantee, optimized for Iraq, Syria, Saudi Arabia, UAE, and all Middle Eastern countries."
      }
    }
  ]
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Nabda OTP",
  "url": "https://nabdaotp.com",
  "logo": "https://nabdaotp.com/assets/android-chrome-192x192.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "availableLanguage": ["English", "Arabic"]
  },
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Nabda OTP",
  "url": "https://nabdaotp.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://nabdaotp.com/countries/{search_term}",
    "query-input": "required name=search_term"
  }
};

const codeExample = `<span class="code-comment">// Sending OTP via Nabda Gateway</span>
<span class="code-keyword">const</span> response = <span class="code-keyword">await</span> Nabda.<span class="code-function">send</span>({
  <span class="code-property">phone</span>: <span class="code-string">"+964750XXXXXXX"</span>,
  <span class="code-property">message</span>: <span class="code-string">"Your code is: 847291"</span>,
  <span class="code-property">type</span>: <span class="code-string">"otp"</span>
});

<span class="code-comment">// ✓ Delivered instantly</span>
console.<span class="code-function">log</span>(response.<span class="code-property">status</span>); <span class="code-comment">// "sent"</span>`;

const faqs = [
  { q: "What is the cheapest WhatsApp API?", a: "Nabda OTP is the cheapest WhatsApp API, offering unlimited messages for just $10/month. No per-message fees, no hidden costs. Save up to 90% compared to Twilio, SendGrid, or UltraMsg." },
  { q: "Best Twilio alternative for WhatsApp?", a: "Nabda OTP is the best Twilio alternative. Twilio charges $0.005–$0.05 per message. With Nabda OTP, send unlimited messages for $10/month — saving up to 90% on costs." },
  { q: "Is there a WhatsApp API with unlimited messages?", a: "Yes! Nabda OTP offers truly unlimited WhatsApp messages for a flat $10/month. No message caps, no per-message fees, no surprises on your bill." },
  { q: "Does Nabda OTP work with Iraqi phone numbers?", a: "Absolutely. Nabda OTP is the first WhatsApp gateway built specifically for Iraq (+964), Syria (+963), and the entire MENA region. Full Arabic language support included." },
  { q: "How long is the free trial?", a: "Nabda OTP offers a 5-day free trial with no credit card required. You get full API access to test OTP sending, notifications, and all features before subscribing." },
  { q: "What payment methods are accepted?", a: "We currently accept Visa and Mastercard. USDT (crypto) payments are coming soon." },
];
---

<BaseLayout
  title="Nabda OTP – Cheapest WhatsApp API $10/mo Unlimited | Twilio & UltraMsg Alternative | Iraq Syria MENA"
  description="🚀 The CHEAPEST WhatsApp OTP API - Just $10/month for UNLIMITED messages! Best Twilio, SendGrid, UltraMsg alternative. First Arab WhatsApp Gateway for Iraq, Syria & MENA. No per-message fees. 5-day free trial."
  canonical="https://nabdaotp.com/"
  schema={[softwareSchema, faqSchema, organizationSchema, websiteSchema]}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-text">
        <div class="badge">🚀 The most reliable WhatsApp verification platform</div>
        <h1 class="hero-title">The Cheapest &amp; First WhatsApp Gateway in Iraq, Syria &amp; MENA Region.</h1>
        <p class="hero-subtitle">Send unlimited OTPs through our cloud gateway. The cheapest, most reliable API solution for developers. Direct integration with the most affordable pricing.</p>
        <div class="hero-cta">
          <a href="https://dash.nabdaotp.com/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Start Free Trial</a>
          <a href="https://api.nabdaotp.com/docs" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
            <span>View Documentation</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
